# Copy to .env.local and fill in from Supabase: Project Settings > API.
# Never commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# The only Google account allowed to sign in.
ALLOWED_EMAIL=

# Free key from https://fdc.nal.usda.gov/api-key-signup (build step 9).
USDA_API_KEY=

# Free key from https://api-dashboard.search.brave.com (build step 11).
BRAVE_API_KEY=
